# Copy to $GMM_DEPLOY_DIR/.env (default /srv/gmm/.env) on the school server and fill it in.
# This file stays on the server. Never commit the real values.

# MySQL
MYSQL_DATABASE=gmm
MYSQL_USER=gmm
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# DataGSM OAuth
DATAGSM_CLIENT_ID=
DATAGSM_REDIRECT_URIS=https://gmm.example.com/auth/callback
DATAGSM_ALLOW_TEACHER=false

# GMM
GMM_ADMIN_EMAILS=
# Empty when the frontend and the API share one origin behind the reverse proxy.
GMM_CORS_ALLOWED_ORIGINS=
GMM_SESSION_COOKIE_SECURE=true
GMM_API_DOCS_ENABLED=false

# Builds and images: a different site from the frontend (see docs/build-upload.md).
GMM_BUILD_PUBLIC_BASE_URL=https://games.example.net
GMM_FRONTEND_ORIGIN=https://gmm.example.com

# Published ports. Keep 127.0.0.1 when a reverse proxy on the same host serves HTTPS.
API_BIND=127.0.0.1
API_PORT=8080
BUILDS_BIND=127.0.0.1
BUILDS_PORT=8081
