# Copy to $GMM_DEPLOY_DIR/.env (default /srv/gmm/.env) on the school server and fill it in.
# This file stays on the server. Never commit the real values.

# MySQL
MYSQL_DATABASE=gmm
MYSQL_USER=gmm
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# DataGSM OAuth
DATAGSM_CLIENT_ID=
DATAGSM_REDIRECT_URIS=https://gmm.example.com/auth/callback
DATAGSM_ALLOW_TEACHER=false

# GMM
GMM_ADMIN_EMAILS=
# Empty when the frontend and the API share one origin behind the reverse proxy.
GMM_CORS_ALLOWED_ORIGINS=
GMM_SESSION_COOKIE_SECURE=true
GMM_API_DOCS_ENABLED=false

# Builds and images: a different site from the frontend (see docs/build-upload.md).
GMM_BUILD_PUBLIC_BASE_URL=https://games.example.net
GMM_FRONTEND_ORIGIN=https://gmm.example.com

# Frontend on this VM: "front" runs nginx on FRONT_PORT with the frontend build and /api.
# Leave empty when the frontend is hosted elsewhere (then set API_BIND=0.0.0.0 and GMM_CORS_ALLOWED_ORIGINS).
COMPOSE_PROFILES=front
GMM_FRONT_DIR=/srv/gmm/front

# Published ports. The school HTTPS proxy connects to the VM's internal IP, so public entry points use 0.0.0.0.
FRONT_BIND=0.0.0.0
FRONT_PORT=80
BUILDS_BIND=0.0.0.0
BUILDS_PORT=8081
API_BIND=127.0.0.1
API_PORT=8080

# Memory. Defaults fit a 2 GB VM (micro tier); with 4 GB use e.g. API_MEM_LIMIT=1536m, MYSQL_BUFFER_POOL=512M, MYSQL_MEM_LIMIT=1g.
API_MEM_LIMIT=768m
MYSQL_MEM_LIMIT=512m
MYSQL_BUFFER_POOL=128M
